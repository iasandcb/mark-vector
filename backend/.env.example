ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Realtime dictation via Soniox (stt-rt-v5). Unset = Soniox is not offered.
# The browser only receives a short-lived temporary key.
# On Fly: fly secrets set SONIOX_API_KEY=...
SONIOX_API_KEY=
# Grok - https://console.x.ai
XAI_API_KEY=
# X Articles export (NOT the xAI/Grok key above). OAuth 1.0a user access
# credentials from an X developer app with Read and Write permissions.
# The publishing account must be eligible for Articles.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Alternative: OAuth 2.0 USER token with tweet.read tweet.write users.read.
# App-only Bearer tokens cannot create Articles. Renew expired user tokens.
# X_USER_ACCESS_TOKEN=
INGEST_TOKEN=
# Bearer token for the YouTube worker queue (/api/worker/...). A different
# secret from INGEST_TOKEN. Unset = that API is off (404).
# On Fly: fly secrets set WORKER_TOKEN="$(openssl rand -hex 32)"
WORKER_TOKEN=
# No API key? `uv run python -m app.chatgpt_auth login` uses your ChatGPT
# plan instead (shows up as the "chatgpt" provider) - see README.
DATA_DIR=../data
# Warn in the workspace when DATA_DIR's disk is at least this percent full.
# 0–100; anything else is ignored and 80 is used.
# STORAGE_WARN_PERCENT=80

# Optional: gates the whole app behind a 4-digit passcode - a lighter
# alternative to setting up GOOGLE_CLIENT_ID/SECRET below, handy for a
# public test deployment. Either one alone turns auth on; both can be set
# at once so either grants access. Must be exactly 4 digits or it's ignored.
# APP_PASSCODE=1234

# Optional: Google sign-in (see backend/app/auth.py). Off entirely unless
# both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ALLOWED_EMAILS=iasandcb@gmail.com

# Optional: any number of OpenAI-compatible endpoints (Hermes, Together,
# Fireworks, OpenRouter, a local vLLM/Ollama/LM Studio server, ...), as a
# JSON array. "models" is optional - omit it to auto-fetch from the
# endpoint's own /v1/models instead.
# CUSTOM_OPENAI_PROVIDERS=[{"id":"hermes","label":"Hermes (Nous)","base_url":"https://inference-api.nousresearch.com/v1","api_key":"...","models":["Hermes-4-70B"]}]
