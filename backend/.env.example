ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Grok - https://console.x.ai
XAI_API_KEY=
# No API key? `uv run python -m app.chatgpt_auth login` uses your ChatGPT
# plan instead (shows up as the "chatgpt" provider) - see README.
DATA_DIR=../data

# Optional: gates the whole app behind a 4-digit passcode - a lighter
# alternative to setting up GOOGLE_CLIENT_ID/SECRET below, handy for a
# public test deployment. Either one alone turns auth on; both can be set
# at once so either grants access. Must be exactly 4 digits or it's ignored.
# APP_PASSCODE=1234

# Optional: Google sign-in (see backend/app/auth.py). Off entirely unless
# both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ALLOWED_EMAILS=iasandcb@gmail.com

# Optional: any number of OpenAI-compatible endpoints (Hermes, Together,
# Fireworks, OpenRouter, a local vLLM/Ollama/LM Studio server, ...), as a
# JSON array. "models" is optional - omit it to auto-fetch from the
# endpoint's own /v1/models instead.
# CUSTOM_OPENAI_PROVIDERS=[{"id":"hermes","label":"Hermes (Nous)","base_url":"https://inference-api.nousresearch.com/v1","api_key":"...","models":["Hermes-4-70B"]}]
